<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <!-- circular button -->
    <item>
        <shape android:shape="oval">
            <!-- Soft gradient for depth -->
            <gradient
                android:startColor="#FFFFFF"
                android:centerColor="#F3F8FF"
                android:endColor="#E2EBF8"
                android:angle="270" />

            <!-- Light border for definition -->
            <stroke
                android:width="1dp"
                android:color="#C8D4E6" />

            <size
                android:width="120dp"
                android:height="120dp" />

            <!-- Optional drop shadow-like padding -->
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp" />
        </shape>
    </item>
</ripple>
