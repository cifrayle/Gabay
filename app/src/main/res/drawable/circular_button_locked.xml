<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base circular gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="#C7D8EB"
                android:centerColor="#B0C4DE"
                android:endColor="#9BB6D6"
                android:angle="270" />

            <stroke
                android:width="1dp"
                android:color="#677FA0" />

            <size
                android:width="120dp"
                android:height="120dp" />
        </shape>
    </item>

    <!-- 🔒 Lock icon overlay -->
    <item
        android:drawable="@drawable/ic_locked"
        android:gravity="center" />
</layer-list>
