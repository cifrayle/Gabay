<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Corner indicators (top-left) -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:width="250dp"
        android:height="40dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="5dp"
                android:color="@color/secondaryColor" />
            <corners
                android:topLeftRadius="12dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Corner indicators (top-right) -->
    <item
        android:top="0dp"
        android:right="0dp"
        android:width="250dp"
        android:height="40dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="5dp"
                android:color="@color/secondaryColor" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="12dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Corner indicators (bottom-left) -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:width="250dp"
        android:height="40dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="5dp"
                android:color="@color/secondaryColor" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>

    <!-- Corner indicators (bottom-right) -->
    <item
        android:bottom="0dp"
        android:right="0dp"
        android:width="250dp"
        android:height="40dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="5dp"
                android:color="@color/secondaryColor" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="12dp" />
        </shape>
    </item>

</layer-list>