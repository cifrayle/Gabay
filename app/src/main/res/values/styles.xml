<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="map">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="BlackTextDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="colorAccent">@color/primaryColor</item> <!-- Your accent color -->
    </style>

    <style name="ToolbarTitleTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">16sp</item> <!-- Adjust size as needed -->
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:textColor">@color/buttonTextColor</item>
    </style>

</resources>