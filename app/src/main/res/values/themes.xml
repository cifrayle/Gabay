<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Gabay" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">#0074B3</item>
        <item name="colorOnPrimary">@color/buttonTextColor</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondaryColor</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/backgroundColor</item>
    </style>

    <style name="Theme.Gabay" parent="Base.Theme.Gabay" />

    <style name="custom_card_view_style" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/custom_card_view</item>

    </style>


    <style name="custom_card_view" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">48dp</item>
        <item name="cornerSizeTopLeft">48dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>
</resources>