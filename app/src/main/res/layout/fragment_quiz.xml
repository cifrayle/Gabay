<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLO"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D8E6F8"
    android:padding="16dp"
    tools:context=".fragments.quiz.QuizFragment">


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/time_background"
        android:layout_width="70dp"
        android:layout_height="40dp"
        android:clickable="false"
        android:elevation="12dp"
        app:cardBackgroundColor="@color/secondaryColor"
        app:cardCornerRadius="40dp"
        app:cardElevation="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@color/transparentBackground"
            android:clickable="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="5dp">

            <ImageButton
                android:id="@+id/time_bgic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center|end"
                android:layout_margin="1dp"
                android:background="@color/transparentBackground"
                android:clickable="false"
                android:contentDescription="Time left"
                android:elevation="0dp"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_time_notif"
                android:textAlignment="center"
                app:tint="@color/primaryColor" />

            <TextView
                android:id="@+id/timerTextView"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:elevation="0dp"
                android:fontFamily="@font/nunito_semibold"
                android:gravity="center|start"
                android:padding="0dp"
                android:text=":10"
                android:textAlignment="center"
                android:textColor="@color/primaryColor"
                android:textSize="16sp"
                android:textStyle="normal" />


        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <TextView
        android:id="@+id/quiz_header"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center|start"
        android:text="Chapter Quiz"
        android:textColor="@color/buttonTextColor"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/quiz_header2"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:fontFamily="@font/nunito_extrabold"
        android:gravity="center"
        android:text="Chapter Quiz"
        android:textColor="@color/transparentBackground"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/question_image"
        android:layout_width="256dp"
        android:layout_height="256dp"
        android:layout_marginTop="64dp"
        android:src="@drawable/letter_c"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/textHolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/question_image">

        <TextView
            android:id="@+id/boldTitle_txtView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_bold"
            android:text="Multiple choice: "
            android:textColor="@color/buttonTextColor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/regTitle_txtView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito"
            android:text="Select the correct sign."
            android:textColor="@color/buttonTextColor"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Answer A -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/Answer_A"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/btn_choose_color_bg"
        android:clickable="true"
        android:elevation="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textHolder">

        <LinearLayout
            android:id="@+id/layout_answer_A"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparentBackground"
            android:clickable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="5dp">

            <ImageButton
                android:id="@+id/img_Answer_A"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="1dp"
                android:background="@drawable/circular_button"
                android:backgroundTint="@color/secondaryColor"
                android:clickable="false"
                android:contentDescription="Change picture"
                android:elevation="0dp"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/letter_a" />

            <TextView
                android:id="@+id/answerTextView_A"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_bold"
                android:paddingStart="12dp"
                android:text="choice a"
                android:textColor="@color/buttonTextColor"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Answer B -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/Answer_B"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@android:color/white"
        android:clickable="true"
        android:elevation="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Answer_A">

        <LinearLayout
            android:id="@+id/layout_answer_B"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="5dp">

            <ImageButton
                android:id="@+id/img_Answer_B"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="1dp"
                android:background="@drawable/circular_button"
                android:clickable="false"
                android:contentDescription="B"
                android:elevation="0dp"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/letter_b" />

            <TextView
                android:id="@+id/answerTextView_B"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_bold"
                android:paddingStart="12dp"
                android:text="choice b"
                android:textColor="@color/buttonTextColor"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Answer C -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/Answer_C"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@android:color/white"
        android:clickable="true"
        android:elevation="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Answer_B">

        <LinearLayout
            android:id="@+id/layout_answer_C"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="5dp">

            <ImageButton
                android:id="@+id/img_Answer_C"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="1dp"
                android:background="@drawable/circular_button"
                android:clickable="false"
                android:contentDescription="C"
                android:elevation="0dp"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/letter_c" />

            <TextView
                android:id="@+id/answerTextView_C"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_bold"
                android:paddingStart="12dp"
                android:text="choice c"
                android:textColor="@color/buttonTextColor"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Answer D -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/Answer_D"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@android:color/white"
        android:clickable="true"
        android:elevation="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Answer_C">

        <LinearLayout
            android:id="@+id/layout_answer_D"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="5dp">

            <ImageButton
                android:id="@+id/img_Answer_D"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="1dp"
                android:background="@drawable/circular_button"
                android:clickable="false"
                android:contentDescription="D"
                android:elevation="0dp"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/letter_d" />

            <TextView
                android:id="@+id/answerTextView_D"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_bold"
                android:paddingStart="12dp"
                android:text="choice d"
                android:textColor="@color/buttonTextColor"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


    <!-- Continue Button (initially hidden) -->

    <Button
        android:id="@+id/submit_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/secondaryColor"
        android:elevation="12dp"
        android:fontFamily="@font/nunito_bold"
        android:text="Submit Answer"
        android:textColor="@color/primaryColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />


    <TextView
        android:id="@+id/question_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/nunito_semibold"
        android:text="Question 1 of 5"
        android:textColor="@color/secondaryColor"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/submit_button" />

</androidx.constraintlayout.widget.ConstraintLayout>

